<mxfile host="65bd71144e">
    <diagram id="reactive-jwt-flow" name="Flujo JWT Reactivo (WebFlux)">
        <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <!-- Título -->
                <mxCell id="title" value="Flujo de autenticación JWT - Reactivo (Spring WebFlux)" style="text;html=1;fontStyle=1;fontSize=14;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="20" width="560" height="30" as="geometry"/>
                </mxCell>

                <!-- Usuario -->
                <mxCell id="user" value="Usuario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="80" y="80" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="user-note" value="Request a endpoint protegido&#xa;con JWT en header (Bearer)" style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="135" width="180" height="35" as="geometry"/>
                </mxCell>

                <!-- JwtService (generación de token) -->
                <mxCell id="jwt-service" value="JwtService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="80" y="200" width="120" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="jwt-service-note" value="Si no tiene token, debe generar uno&#xa;(login → Mono&lt;AuthToken&gt;)" style="text;html=1;align=left;verticalAlign=top;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="80" y="245" width="160" height="30" as="geometry"/>
                </mxCell>

                <!-- SecurityWebFilterChain -->
                <mxCell id="chain" value="SecurityWebFilterChain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="320" y="70" width="200" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="chain-note" value="(ServerHttpSecurity, WebFilter)" style="text;html=1;fontSize=9;align=center;" parent="1" vertex="1">
                    <mxGeometry x="350" y="125" width="140" height="20" as="geometry"/>
                </mxCell>

                <!-- WebFilter 0 -->
                <mxCell id="filter0" value="WebFilter 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="360" y="160" width="120" height="28" as="geometry"/>
                </mxCell>

                <!-- JwtAuthenticationWebFilter -->
                <mxCell id="jwt-filter" value="JwtAuthenticationWebFilter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="340" y="200" width="160" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="jwt-filter-note" value="Valida JWT de forma reactiva (Mono)" style="text;html=1;fontSize=9;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="238" width="200" height="18" as="geometry"/>
                </mxCell>

                <!-- WebFilter n -->
                <mxCell id="filtern" value="WebFilter n" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="360" y="268" width="120" height="28" as="geometry"/>
                </mxCell>

                <!-- Validar token (rombo) -->
                <mxCell id="validate" value="Validar&#xa;Token" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="560" y="185" width="100" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="validate-note" value="Intentar validar JWT" style="text;html=1;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="545" y="268" width="130" height="18" as="geometry"/>
                </mxCell>

                <!-- ReactiveUserDetailsService -->
                <mxCell id="reactive-uds" value="ReactiveUserDetailsService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="720" y="160" width="180" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="reactive-uds-note" value="Toma el username del token y valida&#xa;si existe en BD → Mono&lt;UserDetails&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="720" y="208" width="220" height="32" as="geometry"/>
                </mxCell>

                <!-- Database (R2DBC) -->
                <mxCell id="db" value="Base de datos&#xa;(R2DBC)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="750" y="260" width="120" height="70" as="geometry"/>
                </mxCell>

                <!-- ReactiveSecurityContextHolder -->
                <mxCell id="reactive-ctx" value="ReactiveSecurityContextHolder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="720" y="360" width="180" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="reactive-ctx-note" value="Actualiza el Authentication en el&#xa;ReactiveSecurityContext (Mono/SubscriberContext)" style="text;html=1;align=left;verticalAlign=top;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="720" y="403" width="240" height="32" as="geometry"/>
                </mxCell>

                <!-- Protected RestController -->
                <mxCell id="controller" value="Protected RestController" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="720" y="455" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="controller-note" value="Acceso al endpoint protegido&#xa;(Mono / Flux en respuesta)" style="text;html=1;fontSize=9;align=center;" parent="1" vertex="1">
                    <mxGeometry x="705" y="498" width="190" height="30" as="geometry"/>
                </mxCell>

                <!-- Errores -->
