# Docker Compose — copiar a ".env" en esta carpeta (FINDU-PROJECT/.env)
# Sirve para sustituir ${VAR} en docker-compose.yml (puertos, Postgres, perfil por defecto).
# Las variables de la aplicación (JWT, logs, etc.) siguen en SECURITY/findu-spring-security/.env
#
#   copy .env.example .env

# Perfil Spring del contenedor findu-security (dev | qa | pdn). Lo aplica docker-compose.yml
# y sustituye SPRING_PROFILES_ACTIVE del archivo SECURITY/findu-spring-security/.env.
SPRING_PROFILES_ACTIVE=qa

# Postgres (servicio postgres + sustitución en URLs)
POSTGRES_USER=findu
POSTGRES_PASSWORD=findu
POSTGRES_DB=findu
POSTGRES_PORT=5432

# API expuesta en el host
APP_PORT=8081

# Imagen construida
FINDU_SECURITY_TAG=local

# LocalStack / AWS
AWS_DEFAULT_REGION=us-east-1
LOCALSTACK_PORT=4566
